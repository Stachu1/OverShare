{
  "manifest_version": 3,
  "name": "Discord Bot API Test",
  "version": "1.0.0",
  "description": "Tests sending and reading Discord messages with a bot token directly from the browser.",
  "action": { "default_title": "Open Discord bot test" },
  "background": { "service_worker": "background.js" },
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["https://discord.com/*"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "discord_user_agent", "enabled": true, "path": "rules.json" }]
  }
}
