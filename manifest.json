{
  "manifest_version": 3,
  "name": "Overshare",
  "version": "0.9.1",
  "description": "Send and receive large files on Discord (channels or DMs) by auto-splitting them into chunks and reassembling on download.",
  "action": {
    "default_title": "Overshare",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "scripting", "activeTab", "downloads"],
  "host_permissions": [
    "https://discord.com/*",
    "https://discordapp.com/*",
    "https://cdn.discordapp.com/*",
    "https://media.discordapp.net/*"
  ],
  "icons": {
    "128": "icon128.png"
  }
}
