{
  "manifest_version": 3,
  "name": "OverShare",
  "version": "0.17.0",
  "description": "Send and receive large files or folders on Discord (channels or DMs): zipped, split into chunks, SHA-256 verified, and reassembled on download.",
  "action": {
    "default_title": "OverShare",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "scripting", "activeTab", "downloads"],
  "host_permissions": [
    "https://discord.com/*",
    "https://discordapp.com/*",
    "https://cdn.discordapp.com/*",
    "https://media.discordapp.net/*"
  ],
  "icons": {
    "128": "icon128.png"
  }
}
